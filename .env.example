# Standalone compose.yaml needs none of these settings; its default is localhost:18080.
KEYSMITH_PORT=18080
# HTTPS alternatives: edit to match your DNS/certificate and Docker host address.
KEYSMITH_DOMAIN=keys.example.com
KEYSMITH_BIND_IP=127.0.0.1
# Absolute existing directory OUTSIDE this repository; contains fullchain.pem and privkey.pem.
KEYSMITH_TLS_DIR=/etc/keysmith/tls
