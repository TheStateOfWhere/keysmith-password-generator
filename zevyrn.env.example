# New installations: copy to .env; standalone defaults to localhost:18080.
ZEVYRN_PORT=18080
# Bare DNS hostname matching the certificate SAN; host address for HTTPS binding.
ZEVYRN_DOMAIN=keys.example.com
ZEVYRN_BIND_IP=127.0.0.1
# Absolute existing directory OUTSIDE the clone; fullchain.pem and privkey.pem.
ZEVYRN_TLS_DIR=/etc/zevyrn/tls
